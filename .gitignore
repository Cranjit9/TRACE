# =========================
# Python / Jupyter / VS Code
# =========================
__pycache__/
*.py[cod]

.ipynb_checkpoints/

.vscode/
.DS_Store

# -------------------------
# Virtual environments
# -------------------------
.venv/
venv/
env/
ENV/
.python-version
.env

# -------------------------
# Data (keep out of version control)
# -------------------------
# Ignore the full project data tree by default.
data/

# If you later want to keep the folder structure but selectively track
# specific files, use patterns like:
# !data/
# !data/processed/
# data/processed/*
# !data/processed/example.csv

# Explicitly ignore common large bio formats anywhere
*.gct
*.h5
*.hdf5
*.feather
*.parquet
*.rds
*.pkl
*.pickle

# -------------------------
# Outputs (regenerated)
# -------------------------
output/
reports/
figures/
tables/

# Scripts: ignore the scratch dir by default but track the canonical runner.
scripts/*
!scripts/run_all_nbs.sh

# Python build artifacts
*.egg-info/

# Pipeline run logs
notebooks/_runlogs/

# -------------------------
# Models / artifacts
# -------------------------
models/
checkpoints/
*.joblib

# -------------------------
# Logs / temp
# -------------------------
logs/
*.log
tmp/
temp/
.claude/

# Figure composers under scripts/figures/ are intentionally tracked.
!scripts/figures/
!scripts/figures/**

# Re-exclude bytecode inside the un-ignored scripts/figures tree.
scripts/figures/__pycache__/
scripts/figures/**/*.pyc

# Manuscript drafts (docx/pdf) are kept local, not versioned.
manuscript/
